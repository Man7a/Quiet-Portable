<Window x:Class="QuietGPT.RayMiraWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Ray &amp; Mira · Quiet" Width="710" Height="740" MinWidth="590" MinHeight="560"
 Background="#17201B" Foreground="#EDF3EF" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#101813"/><Setter Property="Foreground" Value="#EDF3EF"/><Setter Property="CaretBrush" Value="#C5F3D6"/><Setter Property="BorderBrush" Value="#496454"/><Setter Property="Padding" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="AcceptsReturn" Value="True"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18"><CheckBox x:Name="EnabledBox" DockPanel.Dock="Right" Content="Connection on" VerticalAlignment="Center" Click="EnabledClick"/><StackPanel><TextBlock Text="Ray &amp; Mira" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Discuss with Ray. Build with Mira." Foreground="#A8BDAF" Margin="0,5,0,0"/></StackPanel></DockPanel>
  <Border Grid.Row="1" Background="#23342A" CornerRadius="10" Padding="14" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Ray &amp; Mira — Workbench" FontWeight="SemiBold"/><TextBlock Text="↔ Quiet GPT browser PROJECT" Foreground="#B4CCBD" Margin="0,5,0,0"/><TextBlock Text="This first version uses this pair of conversations." FontSize="12" Foreground="#9AB4A4" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="1" Content="Open Codex task" Click="OpenTaskClick" VerticalAlignment="Top"/></Grid></Border>
  <Border Grid.Row="2" Background="#101813" CornerRadius="8" Padding="12" Margin="0,0,0,14"><StackPanel><TextBlock x:Name="StateText" Text="Connection off" FontWeight="SemiBold" Foreground="#C5EDCF"/><TextBlock Text="Nothing sends automatically. Copy the reviewed request, then paste and send in Codex." TextWrapping="Wrap" Foreground="#A8BDAF" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border>
  <TabControl Grid.Row="3" x:Name="Tabs" Background="Transparent" BorderThickness="0">
   <TabItem Header="Request"><Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><Button x:Name="LoadReplyButton" DockPanel.Dock="Right" Content="Use Ray’s latest reply" Click="LoadReplyClick"/><TextBlock Text="Review or write a focused request" VerticalAlignment="Center"/></DockPanel><TextBox Grid.Row="1" x:Name="RequestBox" MaxLength="24000" AutomationProperties.Name="Request for Mira" TextChanged="DraftChanged"/><DockPanel Grid.Row="2" Margin="0,12,0,0"><Button x:Name="ReviewButton" DockPanel.Dock="Right" Content="Review handoff →" Background="#365C45" Click="ReviewClick"/><TextBlock Text="Only import from Workbench when its reply is finished." TextWrapping="Wrap" Foreground="#A8BDAF" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/></DockPanel></Grid></TabItem>
   <TabItem Header="Result"><Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Mira’s update for this handoff" Margin="0,0,0,10"/><TextBox Grid.Row="1" x:Name="ResultBox" IsReadOnly="True" AutomationProperties.Name="Mira result" Text="No result yet. After you send the handoff in Codex, Mira can return an update here."/><WrapPanel Grid.Row="2" Margin="0,12,0,0"><Button Content="Check for update" Click="RefreshClick"/><Button x:Name="ReturnButton" Content="Review for Ray →" Background="#365C45" Click="ReturnClick" Margin="8,0,0,0"/><Button x:Name="ReopenButton" Content="Review copied handoff" Click="ReopenClick" Margin="8,0,0,0"/></WrapPanel><Button Grid.Row="3" x:Name="CloseJobButton" Content="Close this handoff…" HorizontalAlignment="Left" Margin="0,8,0,0" Click="CloseJobClick"/></Grid></TabItem>
   <TabItem Header="How it works"><StackPanel Margin="14,18"><TextBlock Text="1. Plan with Ray in Workbench." Margin="0,0,0,16"/><TextBlock Text="2. Import her finished reply or write a request here." TextWrapping="Wrap" Margin="0,0,0,16"/><TextBlock Text="3. Review the exact handoff, copy it and open Codex. Paste and send it in the paired task when you are ready." TextWrapping="Wrap" Margin="0,0,0,16"/><TextBlock Text="4. Mira’s result appears here when she records an update. Review it, then copy it into Workbench for Ray." TextWrapping="Wrap" Margin="0,0,0,16"/><TextBlock Text="Turning the connection off stops new handoffs and background checks. It does not cancel work you already sent in Codex." Foreground="#A8BDAF" TextWrapping="Wrap"/></StackPanel></TabItem>
  </TabControl>
  <TextBlock Grid.Row="4" x:Name="Feedback" TextWrapping="Wrap" Foreground="#C5EDCF" Margin="0,14,0,0" FontSize="12"/>
 </Grid>
</Window>
